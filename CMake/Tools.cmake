string(TOUPPER "PONY_TOOLS_TOOLCHAIN_${CMAKE_HOST_SYSTEM_NAME}" TOOLS_TOOLCHAIN_VARIABLE)
set(TOOLS_TOOLCHAIN ${${TOOLS_TOOLCHAIN_VARIABLE}})
message(STATUS "Tools toolchain: ${TOOLS_TOOLCHAIN}")

ExternalProject_Add(PonyEngineTools
	SOURCE_DIR "${PonyEngine_SOURCE_DIR}"
	BINARY_DIR "${CMAKE_BINARY_DIR}/Tools"
	CMAKE_ARGS
		-G Ninja
		-DCMAKE_BUILD_TYPE=Release
		$<$<BOOL:${TOOLS_TOOLCHAIN}>:-DCMAKE_TOOLCHAIN_FILE=${TOOLS_TOOLCHAIN}>
		-DCMAKE_CXX_STANDARD=23
		-DCMAKE_CXX_STANDARD_REQUIRED=ON
		-DCMAKE_CXX_EXTENSIONS=OFF
		$<$<BOOL:${CMAKE_EXPERIMENTAL_CXX_IMPORT_STD}>:-DCMAKE_EXPERIMENTAL_CXX_IMPORT_STD=${CMAKE_EXPERIMENTAL_CXX_IMPORT_STD}>
		-DCMAKE_CXX_MODULE_STD=ON
		-DCMAKE_INSTALL_PREFIX=${PONY_TOOLS_INSTALL_DIR}
		-DPONY_BUILD_MODE=Tools
	INSTALL_DIR "${PONY_TOOLS_INSTALL_DIR}"
)
